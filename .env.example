# Private installation-owner token. Bootstrap creates a high-entropy value.
# Keep it for administration only; issue separate researcher tokens from the UI.
MIZAN_JUDGE_TOKEN=

# Required 256-bit local encryption key for researchers' personal Meta API keys.
# Generated and stored privately by scripts/bootstrap.py. Back it up separately.
MIZAN_ENCRYPTION_KEY=
MIZAN_ENCRYPTION_KEY_VERSION=

# Shared only with the isolated Phantom service; never commit the real value.
# Generate a random value of at least 32 characters and copy it exactly to Phantom.
MIZAN_PHANTOM_SIGNING_KEY=

# Optional legacy model key for the installation owner only. Researchers should
# save their own keys in their account profile; those are encrypted at rest.
# MODEL_API_KEY=

# Optional shared Meta API configuration (the endpoint receives submitted content).
# Remote endpoints must use HTTPS; redirects are rejected to protect the bearer key.
# Plain HTTP is accepted only for localhost/loopback development endpoints.
# META_API_BASE=https://api.meta.ai/v1
# Primary model order: latest first, then compatible Muse Spark fallbacks.
# The client default is muse-spark-1.3,muse-spark-1.2,muse-spark-1.1.
# META_MODEL=muse-spark-1.3,muse-spark-1.2,muse-spark-1.1
# Optional challenge candidates are filtered to exclude the primary model.
# The default is muse-spark-1.2,muse-spark-1.1; this extra pass is advisory and costs extra usage.
# META_CHALLENGE_MODELS=muse-spark-1.2,muse-spark-1.1
# Muse Spark high reasoning is the default for triage; medium lowers latency/token usage.
# Allowed: minimal, low, medium, high, xhigh, max (max is limited to muse-spark-1.3).
# Keep high if you want the optional cross-version challenge to run on 1.2/1.1 as well.
# META_REASONING_EFFORT=high

# Optional model allowlist. Muse Spark 1.3/1.2/1.1 are enabled by default.
# Muse Wonder is experimental and requires both account access and explicit opt-in.
# Pending image, ASR, SAM, Glimmer, Spark Open, and Llama adapters cannot be enabled here.
# MIZAN_ENABLED_MODELS=muse-wonder-1.0

# Local-runtime settings are reported in the registry only. No local adapter is active,
# so Mizan will not send requests to this endpoint until a reviewed adapter ships.
# MIZAN_LOCAL_MODEL_BASE=http://127.0.0.1:11434/v1
# MIZAN_LOCAL_MODEL_ID=operator-configured-id
# MIZAN_LOCAL_MODEL_API_KEY=

# Default Docker publishing is loopback-only. Remote team access requires a
# private TLS reverse proxy and exact allow-lists; never publish directly to the internet.
# MIZAN_PUBLISH_HOST=127.0.0.1
# MIZAN_ALLOWED_HOSTS=triage.internal.example
# MIZAN_ALLOWED_ORIGINS=https://triage.internal.example

# Optional local settings
# COMPOSE_PROJECT_NAME=mizan-local
# PORT=8000
# MIZAN_DB_PATH=data/mizan.sqlite3

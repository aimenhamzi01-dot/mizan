# Required for this installation's local API access. Create a private value with:
# python3 scripts/bootstrap.py
# The bootstrap script generates a random token, stores it in .env, and prints it once.
MIZAN_JUDGE_TOKEN=

# Optional: your own Meta Model API key for live analysis. Never commit a real key.
MODEL_API_KEY=

# Optional model configuration
# META_API_BASE=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3,muse-spark-1.1
# META_REASONING_EFFORT=medium

# Optional local settings. Docker Compose defaults to port 8000 and publishes only on 127.0.0.1.
# PORT=8000
# MIZAN_DB_PATH=data/mizan.sqlite3
